  <ns0:text>
    <ns0:body>
      <ns0:div type="debate">
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u1">
          <ns0:seg>REPUBLIKA E SHQIPËRISË</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u2">
          <ns0:seg>KUVENDI</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u3">
          <ns0:seg>Konferenca e Kryetarëve</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u4">
          <ns0:seg>PROCESVERBAL</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u5">
          <ns0:seg>Tiranë, më 17.10.2025, ora 11:00</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u6">
          <ns0:seg>Drejton mbledhjen:</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u7">
          <ns0:seg>Niko Peleshi – Kryetar i Kuvendit</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u8">
          <ns0:seg>Rendi i ditës:</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u9">
          <ns0:seg>1.</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u10">
          <ns0:seg>Shqyrtimi i kërkesës nr. 2891 protokolli, datë 13.10.2025, të Grupit Parlamentar</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u11">
          <ns0:seg>të Partisë Demokratike “Për ngritjen e komisionit hetimor të Kuvendit për verifikimin e</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u12">
          <ns0:seg>ligjshmërisë së veprimeve të zyrtarëve shqiptarë në raport me ish-agjentin special të FBI-së,</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u13">
          <ns0:seg>Charles McGonigal”.</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u14">
          <ns0:seg>2.</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u15">
          <ns0:seg>Shqyrtimi i kërkesës nr. 2892 protokolli, datë 13.10.2025, të Grupit Parlamentar</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u16">
          <ns0:seg>të Partisë Demokratike “Për ngritjen e komisionit hetimor të Kuvendit për kontrollin e</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u17">
          <ns0:seg>ligjshmërisë së veprimtarisë të organeve të pushtetit qendror dhe pushtetit vendor, si dhe për të</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u18">
          <ns0:seg>verifikuar përdorimin e burimeve të administratës shtetërore për qëllime elektorale në zgjedhjet e</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u19">
          <ns0:seg>11 majit 2025”.</ns0:seg>
        </ns0:u>
        <ns0:u who="#per_AL_unknown" ana="#role-mp" xml:id="AL_demo.u20">
          <ns0:seg>3.</ns0:seg>
        </ns0:u>
      </ns0:div>
